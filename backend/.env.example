PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=your-secure-jwt-secret-key
JWT_EXPIRES_IN=7d

# Third-Party Upstream Integrations
A1TOPUP_API_URL=https://api.a1topup.com/api/recharge
A1TOPUP_API_TOKEN=your_a1topup_token_here
A1TOPUP_DISTRIBUTOR_ID=your_distributor_id_here

NOBLE_API_URL=https://api.noblewebstudio.in/v1/recharge
NOBLE_API_KEY=your_noble_api_key_here

# Security & Webhook HMAC Secret
WEBHOOK_HMAC_SECRET=your_webhook_hmac_secret_here

# UPI Dynamic QR Settings
PLATFORM_UPI_VPA=your_merchant_vpa@bank
PLATFORM_UPI_NAME=YOUR_MERCHANT_NAME
