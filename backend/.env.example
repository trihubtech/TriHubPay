# ==============================================================================
# TRIHUBPAY B2B MULTI-TIER RECHARGE PLATFORM - PRODUCTION ENVIRONMENT CONFIG
# ==============================================================================

PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://trihub_admin:trihub_secure_pass_2026@localhost:5432/trihub_recharge

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=trihub_technologies_corporate_jwt_secret_2026
JWT_EXPIRES_IN=7d
WEBHOOK_HMAC_SECRET=trihub_webhook_hmac_secret_key_prod_2026

# ------------------------------------------------------------------------------
# DYNAMIC UPSTREAM GATEWAY ROUTING
# Swap providers anytime via ENV without touching any code!
# Options: NEROPAY, NOBLE, A1TOPUP
# ------------------------------------------------------------------------------
PRIMARY_PROVIDER=NEROPAY
FALLBACK_PROVIDER=NOBLE
PROVIDER_FALLBACK_ENABLED=true

# ------------------------------------------------------------------------------
# 1. NEROPAY GATEWAY API (Primary Upstream Provider)
# Reference: https://docs.neropay.co.in
# Obtain your Token from NeroPay Dashboard -> Developer API -> IP & Callback
# ------------------------------------------------------------------------------
NEROPAY_BASE_URL=https://app.neropay.co.in
NEROPAY_TOKEN=your_neropay_token_here
NEROPAY_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 2. NOBLE WEB STUDIO (Dynamic Smart Failover Engine)
# ------------------------------------------------------------------------------
NOBLE_BASE_URL=https://api.noblewebstudio.in
NOBLE_API_KEY=your_noble_api_key_here
NOBLE_API_TOKEN=your_noble_token_here
NOBLE_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 3. LEGACY A1TOPUP (Optional Backward Compatibility Fallback)
# ------------------------------------------------------------------------------
A1TOPUP_API_URL=https://api.a1topup.com/api/recharge
A1TOPUP_API_TOKEN=
A1TOPUP_DISTRIBUTOR_ID=

# ------------------------------------------------------------------------------
# Platform UPI Settings (For Instant Wallet Deposits via Dynamic QR)
# ------------------------------------------------------------------------------
PLATFORM_UPI_VPA=8270873279@upi
PLATFORM_UPI_NAME=TriHub Technologies

# ------------------------------------------------------------------------------
# SMTP Notification / Email OTP Settings
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=trihubtechnologies@gmail.com
SMTP_PASS=hydzxzooflggcggk
SMTP_FROM="TriHubPay Support" <trihubtechnologies@gmail.com>
